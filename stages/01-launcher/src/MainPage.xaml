<Page x:Class="ShenmueLauncher.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <SolidColorBrush x:Key="Accent" Color="#C8372D"/>
    <SolidColorBrush x:Key="Card" Color="#E61B1B1F"/>
    <SolidColorBrush x:Key="Muted" Color="#A0A0A8"/>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="MinWidth" Value="150"/>
      <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="#34343B"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0B0E" Offset="0"/>
        <GradientStop Color="#2A1013" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <!-- Tela desenhada em 960x540 (resolução efetiva do Xbox) e escalada para qualquer janela. -->
    <Viewbox Stretch="Uniform">
      <Grid Width="960" Height="540" Padding="40,26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="290"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Login: QR code sempre na tela -->
        <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12" Padding="20,18">
          <StackPanel Spacing="10">
            <TextBlock Text="SHENMUE I &amp; II" FontSize="24" FontWeight="Bold" CharacterSpacing="80"/>
            <Rectangle Height="3" Width="70" Fill="{StaticResource Accent}" HorizontalAlignment="Left"/>
            <TextBlock Text="Entre com o app Steam no celular" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            <Grid Width="232" Height="232" HorizontalAlignment="Center" Margin="0,4,0,0">
              <Border Background="White" CornerRadius="8"/>
              <Image x:Name="QrImage" Margin="10"/>
              <StackPanel x:Name="QrOverlay" Background="#F21B1B1F" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="16">
                <TextBlock x:Name="QrOverlayIcon" Text="..." FontSize="44" HorizontalAlignment="Center" Margin="0,48,0,8"/>
                <TextBlock x:Name="QrOverlayText" Text="Conectando à Steam" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="LoginStatus" FontSize="13" TextWrapping="Wrap" Text="Conectando à Steam..."/>
            <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="No app Steam: Steam Guard, ícone de QR. Nenhuma senha é digitada ou salva aqui."/>
          </StackPanel>
        </Border>

        <!-- Jogos -->
        <Grid Grid.Column="2" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="12" Padding="20,16">
            <StackPanel Spacing="8">
              <Grid>
                <TextBlock Text="Shenmue" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="State1" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel x:Name="Progress1" Visibility="Collapsed" Spacing="4">
                <ProgressBar x:Name="Bar1" Minimum="0" Maximum="1" Height="6" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ProgressText1" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="Play1" Content="JOGAR" Style="{StaticResource Primary}" Click="Play_Click" Tag="1"/>
                <Button x:Name="Download1" Content="Baixar" Style="{StaticResource Primary}" Click="Download_Click" Tag="1"/>
                <Button x:Name="Repair1" Content="Verificar arquivos" Style="{StaticResource Secondary}" Click="Download_Click" Tag="1"/>
                <Button x:Name="Delete1" Content="Apagar" Style="{StaticResource Secondary}" Click="Delete_Click" Tag="1"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <CheckBox x:Name="Ws1" Content="Widescreen nas cenas" FontSize="12" MinWidth="0" Padding="6,4,0,0" Click="Mod_Click"/>
                <CheckBox x:Name="Ptbr1" Content="Legendas em português" FontSize="12" MinWidth="0" Padding="6,4,0,0" Click="Mod_Click"/>
                <CheckBox x:Name="Tex1" Content="Texturas em alta definição" FontSize="12" MinWidth="0" Padding="6,4,0,0" Click="Mod_Click"
                          ToolTipService.ToolTip="Pack grande (vários GB); ao ligar pela primeira vez, demora para copiar os arquivos."/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12" Padding="20,16">
            <StackPanel Spacing="8">
              <Grid>
                <TextBlock Text="Shenmue II" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="State2" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel x:Name="Progress2" Visibility="Collapsed" Spacing="4">
                <ProgressBar x:Name="Bar2" Minimum="0" Maximum="1" Height="6" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ProgressText2" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="Play2" Content="JOGAR" Style="{StaticResource Primary}" Click="Play_Click" Tag="2"/>
                <Button x:Name="Download2" Content="Baixar" Style="{StaticResource Primary}" Click="Download_Click" Tag="2"/>
                <Button x:Name="Repair2" Content="Verificar arquivos" Style="{StaticResource Secondary}" Click="Download_Click" Tag="2"/>
                <Button x:Name="Delete2" Content="Apagar" Style="{StaticResource Secondary}" Click="Delete_Click" Tag="2"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="18">
                <CheckBox x:Name="Ws2" Content="Widescreen nas cenas" FontSize="12" MinWidth="0" Padding="6,4,0,0" Click="Mod_Click"/>
                <CheckBox x:Name="Borders2" Content="Sem bordas (experimental)" FontSize="12" MinWidth="0" Padding="6,4,0,0" Click="Mod_Click"/>
                <CheckBox x:Name="Camera2" Content="Sem ícone de câmera (exp.)" FontSize="12" MinWidth="0" Padding="6,4,0,0" Click="Mod_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Rodapé: espaço livre, última execução, log -->
          <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="12" Padding="16,12">
            <Grid RowSpacing="6">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,120,0" VerticalAlignment="Center"/>
                <Button Content="Ver log" Style="{StaticResource Secondary}" Click="Log_Click" HorizontalAlignment="Right" Padding="12,4"/>
              </Grid>
              <TextBlock x:Name="LastRun" Grid.Row="1" FontSize="10.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#D8B0B0"/>
              <TextBlock x:Name="Credits" Grid.Row="2" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="Mods incluídos: widescreen por ner0 e Esppiral (Shenmue Dojo) · legendas em português por Tribo Gamer."/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</Page>
